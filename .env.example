# ═══════════════════════════════════════════════════════════════════
#  Garfix — متغيرات البيئة
#  انسخ هذا الملف إلى .env للتشغيل المحلي:
#     cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── 1) قاعدة البيانات (إلزامي — بدونها لا يعمل أي شيء) ──
# محلياً: PostgreSQL على جهازك (انظر scripts/setup-postgres.sh)
# Vercel: أنشئ قاعدة Postgres مجانية من Neon (neon.tech) أو Supabase
#         أو Vercel Postgres ثم ضع رابط الاتصال هنا.
DATABASE_URL=postgresql://garfix:garfix2024@127.0.0.1:5432/garfix?schema=public

# ── 2) كلمة مرور حساب المؤسس (إلزامي عملياً) ──
# بلا قيمة لا يعمل حساب المؤسس أصلاً (فشل مغلق) — لن تستطيع الدخول إطلاقاً.
# ⚠️ عند النشر العلني: ضع قيمة قوية سرية (ليست admin123).
GARFIX_MASTER_PASSWORD=

# ── 3) سر توقيع الجلسات (إلزامي على Vercel) ──
# بدون هذا السر تُوقّع كل نسخة serverless الجلسات بسر عشوائي مختلف،
# فيُسجَّل دخولك ثم تُطرد فوراً في الطلب التالي (401) — أشهر أعراض النشر المكسور.
# ولّده بأمر:  openssl rand -hex 32
SESSION_SECRET=

# ── 4) الحسابات التجريبية الخمسة ──
# تعمل فقط عند true (موظفو العرض: tawfeer/mahhal/boss/laqta/ayman).
# اتركها معطّلة في النشر العلني — حساب المؤسس يعمل دائماً بصرف النظر عن هذا الخيار.
# DEMO_MODE=true

# ── 5) النشر خلف HTTPS (Vercel) ──
# اجعلها true على Vercel حتى يصبح كوكي الجلسة secure.
# COOKIE_SECURE=true

# ── 6) العنوان العام للتطبيق (مستحسن على Vercel) ──
# مثل https://garfix.vercel.app — يُستخدم في رابط بريد «نسيت كلمة المرور»
# بدل هيدر Host (وقاية من reset-poisoning). يُقبل SITE_URL كبديل.
# APP_BASE_URL=

# ── الكاش (Valkey/Redis) — اختياري ──
# عند غيابه يعمل النظام بكاش ذاكرة داخلي (كافٍ جداً على Vercel).
# VALKEY_URL=redis://:STRONG_PASSWORD@host:6379
# VALKEY_PASSWORD=STRONG_PASSWORD

# ── خدمة PDF المستقلة (اختياري — للتشغيل الذاتي فقط) ──
# على Vercel لا تعمل تصديرات PDF (لا يوجد Chromium/خدمة محلية) — يظهر خطأ واضح.
# PDF_SERVICE_URL=http://127.0.0.1:3040/

# ── الذكاء الاصطناعي (DeepSeek) ──
# لا يُضبط من هنا: أدخل المفتاح من الواجهة → تبويب 🧠 DeepSeek → يُخزَّن مشفراً في قاعدة البيانات

# ── المرحلة 2 (Agent Engine — وكيل جارفِكس) ──
# AGENT_AMOUNT_CAP=5000
# AGENT_MAX_STEPS=8

# ── المرحلة 1 (تكامل Garfix Stores) ──
# GARFIX_WEBHOOK_SECRET=
# STORES_BASE_URL=http://localhost:3001
