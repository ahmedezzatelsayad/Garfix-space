# ── قاعدة البيانات (PostgreSQL 17 محلي — انظر README قسم البنية التحتية) ──
DATABASE_URL=postgresql://garfix:garfix2024@127.0.0.1:5432/garfix?schema=public

# ── الكاش (Valkey 8.1 — بديل Redis) — اختياري: عند غيابه يعمل النظام بكاش ذاكرة داخلي ──
# r29: Valkey يعمل الآن بـ requirepass (وقاية من تهريب الأوامر عبر بروكسي XTransformPort).
# ⚠️ عند النشر العلني: ولّد كلمة مرور قوية، ضعها في requirepass بالـ valkey.conf،
# وفي VALKEY_URL/VALKEY_PASSWORD هنا (نفس القيمة) — وابدأ Valkey وNext وjob-worker من جديد.
# VALKEY_URL=redis://:STRONG_PASSWORD@127.0.0.1:6379
# VALKEY_PASSWORD=STRONG_PASSWORD

# ── الذكاء الاصطناعي (DeepSeek) ──
# لا يُضبط من هنا: أدخل المفتاح من الواجهة → تبويب 🧠 DeepSeek → يُخزَّن مشفراً في قاعدة البيانات

# ── المرحلة 2 (Agent Engine — وكيل جارفِكس) ──
# سقف المبالغ التي يلمسها الوكيل (إلغاء فواتير…) بالدينار — ما يتجاوزه يُحجب (AMOUNT_CAP)
# AGENT_AMOUNT_CAP=5000
# الحد الأقصى لخطوات حلقة Think→Act→Observe في التشغيلة الواحدة (1-12)
# AGENT_MAX_STEPS=8

# ── المرحلة 1 (تكامل Garfix Stores) ──
# سر توقيع webhooks بين ERP ومنصة المتاجر — نفس القيمة في .env الخاص بالمتاجر
# GARFIX_WEBHOOK_SECRET=
# عنوان منصة المتاجر (زر «متاجر Garfix» + تجهيز متاجر الوكيل server-to-server)
# STORES_BASE_URL=http://localhost:3001

# ── جاهزية الإنتاج (r28) ──
# الحسابات التجريبية الخمسة (موظفو العرض) تعمل فقط عند true — اتركها معطّلة في النشر العلني.
# حساب المؤسس الرئيسي يعمل دائماً بصرف النظر عن هذا الخيار.
# DEMO_MODE=true

# كلمة مرور حساب المؤسس الرئيسي — ⚠️ غيّرها إلزامياً عند النشر العلني إلى قيمة قوية سرية.
# عند تركها فارغة تعمل القيمة الافتراضية التجريبية (مناسبة للتطوير/العرض فقط).
# GARFIX_MASTER_PASSWORD=

# أضف true عند النشر خلف HTTPS ليصبح كوكي الجلسة secure (محلياً عبر HTTP اتركه معطّلاً).
# COOKIE_SECURE=true

# ── جاهزية الإنتاج (r29) ──
# العنوان العام للتطبيق (https://app.garfix.com مثلاً) — يُستخدم في رابط بريد
# «نسيت كلمة المرور» بدل هيدر Host (وقاية من reset-poisoning). يُقبل SITE_URL كبديل.
# APP_BASE_URL=
