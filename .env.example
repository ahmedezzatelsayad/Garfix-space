# ── قاعدة البيانات (PostgreSQL 17 محلي — انظر README قسم البنية التحتية) ──
DATABASE_URL=postgresql://garfix:garfix2024@127.0.0.1:5432/garfix?schema=public

# ── الكاش (Valkey 8.1 — بديل Redis) — اختياري: عند غيابه يعمل النظام بكاش ذاكرة داخلي ──
# VALKEY_URL=redis://127.0.0.1:6379

# ── الذكاء الاصطناعي (DeepSeek) ──
# لا يُضبط من هنا: أدخل المفتاح من الواجهة → تبويب 🧠 DeepSeek → يُخزَّن مشفراً في قاعدة البيانات

# ── جاهزية الإنتاج (r28) ──
# الحسابات التجريبية الخمسة (موظفو العرض) تعمل فقط عند true — اتركها معطّلة في النشر العلني.
# حساب المؤسس الرئيسي يعمل دائماً بصرف النظر عن هذا الخيار.
# DEMO_MODE=true

# كلمة مرور حساب المؤسس الرئيسي — ⚠️ غيّرها إلزامياً عند النشر العلني إلى قيمة قوية سرية.
# عند تركها فارغة تعمل القيمة الافتراضية التجريبية (مناسبة للتطوير/العرض فقط).
# GARFIX_MASTER_PASSWORD=

# أضف true عند النشر خلف HTTPS ليصبح كوكي الجلسة secure (محلياً عبر HTTP اتركه معطّلاً).
# COOKIE_SECURE=true
