generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// r12: Company — full editable profile (was minimal id/name/slug).
// Nullable fields → frontend falls back to hardcoded defaults per field;
// `code` is the short routing id (e.g. "tawfeer"), `slug` stays the storage key (tw_inv_…_v1),
// `currency` is ISO-4217 (default KWD — the Kuwaiti market baseline).
model Company {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique // storage key: tw_inv_x_v1 (used as companySlug everywhere)
  code            String?  @unique // short routing code: tawfeer | mahhal | boss | laqta | …
  currency        String   @default("KWD")
  nameAr          String?
  phone           String?
  email           String?
  address         String?
  city            String?
  sellerRef       String?
  manager         String?
  managerPhone    String?
  color           String?
  accent          String?
  cardBg          String?
  emoji           String?
  logo            String?
  // r18: الضرائب الاختيارية — تفعيل الضريبة لفواتير الشركة + النسبة الافتراضية (%)
  // النسبة المقترحة من ضريبة بلد الشركة (VAT) وقابلة للتعديل يدوياً لكل فاتورة.
  taxEnabled      Boolean  @default(true)
  defaultTaxRate  Float? // مثل 15 (السعودية) / 5 (الإمارات) / 0 (الكويت) — فارغ = بلا ضريبة
  firebaseOwnerId String?
  // ── المرحلة 1 (تكامل Garfix Stores): slug متجر المسوّق في منصة المتاجر —
  // يربط أوامر المتجر بشركة الـ ERP المستقبِلة لها (webhook order.created).
  storesSlug      String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Client {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  company     String?
  address     String?
  country     String?  // r23: كود الدولة ISO-3166 alpha-2 (مثل KW)
  governorate String?  // r23: اسم المحافظة/المقاطعة الأساس (إنجليزي — يُعرض عربياً حسب اللغة)
  companyId   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // r29 (M10): عزل قوائم العملاء لكل شركة يستفيد من فهرس على company
  @@index([company])
  @@map("clients")
}

model Invoice {
  id            Int           @id @default(autoincrement())
  payments      Payment[]
  reminders     ReminderLog[]
  invoiceNumber String
  companySlug   String?
  clientId      Int?
  companyId     Int?
  clientName    String
  clientEmail   String?
  clientPhone   String?
  clientAddress String?
  issueDate     String
  dueDate       String
  status        String        @default("draft")
  lineItems     String        @default("[]")
  subtotal      Float         @default(0)
  taxRate       Float         @default(0)
  taxAmount     Float         @default(0)
  total         Float         @default(0)
  shipping      Float         @default(0)
  paid          Float         @default(0)
  notes         String?
  source        String?
  // ── المرحلة 1 (تكامل Garfix Stores): مرجع خارجي للأمر الذي أنشأ الفاتورة —
  // رقم الطلب في منصة المتاجر. القيد الفريد يجعل استقبال الـ webhook idempotent
  // (إعادة الإرسال أو المحاولة المتزامنة لا تُنشئ فاتورة مكررة أبداً).
  externalSource String?
  externalRef    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // r29 (C7): تفرّد رقم الفاتورة داخل الشركة — يجعل الترقية race-safe
  // (تعارضان متزامنان يفشل الثاني بـ P2002 فيُعاد المحاولة برقم جديد).
  // ملاحظة Postgres: companySlug الفارغ يعامَل NULLs-distinct فلا يقيّد السطور غير المسندة.
  @@unique([companySlug, invoiceNumber])
  // المرحلة 1: فاتورة واحدة لكل أمر خارجي داخل الشركة (idempotency للـ webhooks)
  @@unique([companySlug, externalSource, externalRef])
  // r29 (M10): كل استعلامات القوائم/الداشبورد/الذكاء ترشّح بالشركة
  @@index([companySlug])
  @@map("invoices")
}

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  amount    Float
  method    String   @default("knet") // cash | knet | online | card
  date      String // YYYY-MM-DD
  note      String?
  // ── المرحلة 1: مرجع أمر المتجر الذي ولّد هذه الدفعة (COD مُحصّل) —
  // فريد عالمياً: إعادة إرسال حدث delivered لا تسجّل الدفعة مرتين.
  externalRef String? @unique
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model ProductCatalog {
  id            Int      @id @default(autoincrement())
  name          String
  aliases       String   @default("[]")
  purchasePrice Float?
  sellingPrice  Float?
  companySlug   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("product_catalog")
}

model PurchaseInvoice {
  id               Int      @id @default(autoincrement())
  num              String
  date             String
  supplier         String   @default("")
  companySlug      String?
  items            String   @default("[]")
  sourceInvoiceIds String   @default("[]")
  totalQty         Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())

  @@map("purchase_invoices")
}

model ReminderLog {
  id          Int      @id @default(autoincrement())
  invoiceId   Int?
  companySlug String?
  clientName  String?
  clientPhone String?
  channel     String   @default("whatsapp") // whatsapp | call | manual
  message     String?
  amount      Float? // remaining amount at reminder time
  createdAt   DateTime @default(now())
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companySlug])
  @@map("reminder_logs")
}

// r9: server-side company settings (pay-link templates, credit limits …)
// value is a JSON string (object/map/array) — converted in the API layer
model Setting {
  id          Int      @id @default(autoincrement())
  key         String // e.g. paylink_tpl_{companyId} | credit_{companyId}
  value       String   @default("{}")
  companySlug String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([key, companySlug])
  @@map("settings")
}

// r10: مزوّد الذكاء الاصطناعي (DeepSeek) — إعداد على مستوى المشروع بأكمله
model AiSetting {
  id              Int       @id @default(autoincrement())
  provider        String    @unique @default("deepseek")
  apiKey          String? // مفتاح DeepSeek API
  baseUrl         String    @default("https://api.deepseek.com")
  model           String    @default("deepseek-chat") // deepseek-chat | deepseek-reasoner
  enabled         Boolean   @default(false)
  lastTestOk      Boolean? // نتيجة آخر اختبار اتصال
  lastTestedAt    DateTime?
  lastTestModel   String?
  lastTestLatency Int? // ملّي ثانية
  lastTestError   String?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@map("ai_settings")
}

// r10: محادثات المساعد الذكي — محفوظة على الخادم لكل شركة
// r29 (S3): ownerEmail = بريد منشئ المحادثة — تُحصر القائمة/القراءة/الحذف
// في محادثات المستخدم نفسه أو محادثات شركاته المتاحة (المدير يرى الكل).
model AiConversation {
  id          Int         @id @default(autoincrement())
  title       String      @default("محادثة جديدة")
  companySlug String?
  ownerEmail  String?
  model       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages    AiMessage[]

  @@index([companySlug])
  @@index([ownerEmail])
  @@map("ai_conversations")
}

// r10: رسائل المحادثة (user | assistant | system)
model AiMessage {
  id             Int            @id @default(autoincrement())
  conversationId Int
  role           String
  content        String
  model          String?
  latencyMs      Int?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// r13: فريق العمل — يُعرض في صفحة الفريق بالموقع العام ويُدار من تبويب 🌐 الموقع
model TeamMember {
  id        Int      @id @default(autoincrement())
  name      String
  role      String   @default("عضو الفريق")
  bio       String? // نبذة قصيرة (أسطر مفصولة بـ \n)
  emoji     String? // أفاتار بديل عند غياب صورة (مثل 🧑‍💼)
  photoUrl  String? // رابط صورة اختياري (https://…)
  email     String?
  linkedin  String?
  twitter   String?
  sortOrder Int      @default(0) // الأصغر أولاً
  published Boolean  @default(true) // false = مسودة لا تظهر بالموقع العام
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

// r13: محتوى صفحات الموقع العام (رسالة المؤسس، عناوين البطل…)
// key مثل: founder_name | founder_title | founder_message | hero_title | hero_sub
model SiteContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("site_content")
}

// r16: مشتركو التطبيق المسجّلون ذاتياً — «مجاناً لأول 100 مشترك»
// كلمة المرور مخزنة بصيغة scrypt (salt$hash) — لا نص صريح أبداً.
// companies: JSON string بمصفوفة slugs الشركات المرتبطة بالمشترك
// (تُربط تلقائياً عند إنشاء شركته الأولى بعد التسجيل).
model AppUser {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String
  displayName   String
  phone         String?
  role          String    @default("subscriber") // subscriber (لا صلاحيات إدارية خادمياً)
  plan          String    @default("free_early") // كود الخطة من subscription_plans (r17)
  companies     String    @default("[]")
  countryCode   String? // r17: بلد التسجيل حسب الـ IP (KW/SA/EG/…) — r18: قابل للتغيير من «حسابي»
  lang          String? // r18: لغة الواجهة المفضلة (ar/en/fr/… من سجل اللغات)
  planUpdatedAt DateTime? // r17: آخر مرة غيّر المؤسس/المشترك خطته
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("app_users")
}

// r16: رموز استعادة كلمة المرور — تُرسل بالبريد عبر Resend
// tokenHash = SHA-256 للرمز الأصلي (لا يُخزَّن الرمز نفسه)، صلاحية 30 دقيقة، استخدام واحد.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("password_resets")
}

// r17: خطط الاشتراك — تحدد سعة (فواتير معالجة بالذكاء الاصطناعي شهرياً / عملاء / شركات)
// السعر بالدولار الأمريكي (USD) ويُحوَّل لعملة بلد الزائر حسب الـ IP عبر /api/pricing
model SubscriptionPlan {
  id                Int      @id @default(autoincrement())
  code              String   @unique // free_early | starter | pro | business
  nameAr            String
  descAr            String?
  priceUsd          Float    @default(0) // شهرياً بالدولار
  maxCompanies      Int      @default(1)
  maxCustomers      Int      @default(20)
  monthlyAiInvoices Int      @default(50)
  features          String   @default("[]") // JSON: قائمة ميزات عربية للعرض
  badgeAr           String? // شارة مثل «الأكثر شيوعاً»
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("subscription_plans")
}

// r17: عدّادات الاستخدام الشهرية لكل مشترك — فواتير الذكاء الاصطناعي المعالجة
model UsageCounter {
  id         Int      @id @default(autoincrement())
  userId     Int
  period     String // "2026-09" (YYYY-MM بالتوقيت المحلي للخادم)
  aiInvoices Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, period])
  @@map("usage_counters")
}

// ── المرحلة 2 (Agent Engine): سجل تدقيق الوكيل ──
// كل استدعاء أداة من حلقة Think→Act→Observe يمر من هنا: الأداة ووسائطها
// (معقّمة من البيانات الحساسة)، النتيجة، مدة التنفيذ، ومن حجبته الحواجز
// الأمنية (blocked) ولماذا — مساءلة كاملة لكل ما لمسه الوكيل في النظام.
model AgentAuditLog {
  id          Int      @id @default(autoincrement())
  runId       String // معرف التشغيلة (uuid) — خطوات الجلسة الواحدة مجمّعة
  step        Int      @default(0) // رقم الخطوة داخل التشغيلة
  tool        String // اسم الأداة المستدعاة
  kind        String   @default("read") // read | write
  args        String   @default("{}") // JSON معقّم
  ok          Boolean  @default(false) // هل نجح التنفيذ فعلياً (المحجوب = false)
  blocked     String? // كود الحاجز: READONLY_MODE | AMOUNT_CAP | NOT_ADMIN | NO_SUCH_TOOL | INVALID_ARGS | STORES_UNREACHABLE
  result      String?  @default("{}") // ملخص النتيجة JSON
  durationMs  Int      @default(0)
  userEmail   String // من شغّل الوكيل (المسؤول عن التشغيلة)
  companySlug String?
  mode        String   @default("readonly") // readonly | auto | confirmed
  createdAt   DateTime @default(now())

  @@index([runId])
  @@index([userEmail, createdAt])
  @@index([companySlug, createdAt])
  @@map("agent_audit_log")
}

// r17: طلبات ترقية الخطة من المشتركين — يعتمدها المؤسس أو يرفضها من لوحة الإدارة
model PlanRequest {
  id        Int      @id @default(autoincrement())
  userId    Int
  planCode  String
  note      String?
  status    String   @default("pending") // pending | approved | rejected
  handledBy String? // بريد المؤسس الذي عالج الطلب
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("plan_requests")
}
