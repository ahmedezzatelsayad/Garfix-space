generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  firebaseOwnerId String?
  createdAt       DateTime @default(now())
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  companyId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Invoice {
  id            Int      @id @default(autoincrement())
  payments      Payment[]
  reminders     ReminderLog[]
  invoiceNumber String
  companySlug   String?
  clientId      Int?
  companyId     Int?
  clientName    String
  clientEmail   String?
  clientPhone   String?
  clientAddress String?
  issueDate     String
  dueDate       String
  status        String   @default("draft")
  lineItems     String   @default("[]")
  subtotal      Float    @default(0)
  taxRate       Float    @default(0)
  taxAmount     Float    @default(0)
  total         Float    @default(0)
  shipping      Float    @default(0)
  paid          Float    @default(0)
  notes         String?
  source        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("invoices")
}

model Payment {
  id         Int      @id @default(autoincrement())
  invoiceId  Int
  amount     Float
  method     String   @default("knet") // cash | knet | online | card
  date       String   // YYYY-MM-DD
  note       String?
  createdAt  DateTime @default(now())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model ProductCatalog {
  id            Int      @id @default(autoincrement())
  name          String
  aliases       String   @default("[]")
  purchasePrice Float?
  sellingPrice  Float?
  companySlug   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("product_catalog")
}

model PurchaseInvoice {
  id               Int      @id @default(autoincrement())
  num              String
  date             String
  supplier         String   @default("")
  companySlug      String?
  items            String   @default("[]")
  sourceInvoiceIds String   @default("[]")
  totalQty         Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())

  @@map("purchase_invoices")
}

model ReminderLog {
  id          Int      @id @default(autoincrement())
  invoiceId   Int?
  companySlug String?
  clientName  String?
  clientPhone String?
  channel     String   @default("whatsapp") // whatsapp | call | manual
  message     String?
  amount      Float? // remaining amount at reminder time
  createdAt   DateTime @default(now())
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companySlug])
  @@map("reminder_logs")
}

// r9: server-side company settings (pay-link templates, credit limits …)
// value is a JSON string (object/map/array) — converted in the API layer
model Setting {
  id          Int      @id @default(autoincrement())
  key         String // e.g. paylink_tpl_{companyId} | credit_{companyId}
  value       String   @default("{}")
  companySlug String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([key, companySlug])
  @@map("settings")
}

// r10: مزوّد الذكاء الاصطناعي (DeepSeek) — إعداد على مستوى المشروع بأكمله
model AiSetting {
  id              Int       @id @default(autoincrement())
  provider        String    @default("deepseek") @unique
  apiKey          String? // مفتاح DeepSeek API
  baseUrl         String    @default("https://api.deepseek.com")
  model           String    @default("deepseek-chat") // deepseek-chat | deepseek-reasoner
  enabled         Boolean   @default(false)
  lastTestOk      Boolean? // نتيجة آخر اختبار اتصال
  lastTestedAt    DateTime?
  lastTestModel   String?
  lastTestLatency Int? // ملّي ثانية
  lastTestError   String?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@map("ai_settings")
}

// r10: محادثات المساعد الذكي — محفوظة على الخادم لكل شركة
model AiConversation {
  id          Int         @id @default(autoincrement())
  title       String      @default("محادثة جديدة")
  companySlug String?
  model       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages    AiMessage[]

  @@index([companySlug])
  @@map("ai_conversations")
}

// r10: رسائل المحادثة (user | assistant | system)
model AiMessage {
  id             Int            @id @default(autoincrement())
  conversationId Int
  role           String
  content        String
  model          String?
  latencyMs      Int?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}
